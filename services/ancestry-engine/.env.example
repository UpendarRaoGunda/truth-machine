ANCESTRY_UPLOAD_SECRET=replace-with-a-long-random-shared-secret
GENOME_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
ANCESTRY_ALLOWED_ORIGINS=https://truth-machine-coral.vercel.app
ANCESTRY_STORAGE_ROOT=/data/ancestry
ANCESTRY_WORK_ROOT=/dev/shm/truth-machine-ancestry
ANCESTRY_RESULT_TTL_HOURS=24
ANCESTRY_MAX_UPLOAD_BYTES=262144000

# Optional reviewed tool adapters. Each command must write JSON to {output}.
ANCESTRY_REFERENCE_PIPELINE_COMMAND=
HAPLOGREP_COMMAND=
Y_LINEAGE_COMMAND=
ADMIXTOOLS_COMMAND=

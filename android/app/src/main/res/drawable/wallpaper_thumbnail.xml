<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#03110F"
                android:endColor="#0B2A24" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:left="24dp"
        android:top="40dp"
        android:right="24dp"
        android:bottom="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A4FF0C4" />
            <stroke android:width="1dp" android:color="#4FF0C4" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
